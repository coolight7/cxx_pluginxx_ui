{
  "title": "核心组件",
  "subtitle": { "key": "demo.subtitle", "fallback": "全部核心组件各一份", "args": { "n": 3 } },
  "blocks": [
    { "kind": "Text", "text": "正文", "type": "body" },
    { "kind": "Text", "text": "标题行", "type": "title" },
    { "kind": "Text", "text": "说明文字", "type": "caption", "tone": "hint", "mono": true, "align": "end" },
    { "kind": "Divider" },
    { "kind": "Gap", "size": 12 },
    { "kind": "Gap", "size": { "percent": 10 } },
    { "kind": "Button", "label": "保存", "variant": "primary", "action": "apply" },
    {
      "kind": "Block",
      "title": "卡片",
      "variant": "inset",
      "padding": { "horizontal": 12, "vertical": 8 },
      "margin": 4,
      "children": [
        {
          "kind": "Row",
          "gap": 12,
          "main": "spaceBetween",
          "cross": "center",
          "children": [
            { "kind": "Text", "text": "左" },
            { "kind": "Expanded", "flex": 2, "children": [{ "kind": "Text", "text": "中间" }] },
            { "kind": "Spacer", "flex": 1 },
            { "kind": "Text", "text": "右" }
          ]
        }
      ]
    },
    {
      "kind": "Column",
      "gap": 8,
      "children": [
        { "kind": "Text", "text": "第一行" },
        { "kind": "Text", "text": "第二行" }
      ]
    },
    { "kind": "SizedBox", "width": 120, "height": { "percent": 40 }, "aspect": 1.5 },
    {
      "kind": "Padding",
      "padding": { "left": 20, "top": 8 },
      "children": [{ "kind": "Text", "text": "内边距" }]
    },
    { "kind": "Align", "align": "end", "vertical": "center", "children": [{ "kind": "Text", "text": "靠右" }] },
    {
      "kind": "Collapse",
      "id": "detail",
      "title": "详细信息",
      "expanded": false,
      "children": [{ "kind": "Text", "text": "折叠内容" }]
    },
    {
      "kind": "KV",
      "keyWidth": "auto",
      "pairs": [
        { "k": "模型", "v": "gpt-5" },
        { "k": { "key": "demo.tokens", "fallback": "令牌数" }, "v": "1280", "vTone": "accent" }
      ]
    },
    {
      "kind": "Table",
      "header": true,
      "columns": [
        { "title": "名称" },
        { "title": "耗时", "align": "end", "width": 60 }
      ],
      "rows": [
        ["编译", "1.4s"],
        [{ "text": "测试", "tone": "accent" }, "0.6s"]
      ]
    },
    {
      "kind": "Tree",
      "connector": true,
      "nodes": [
        { "label": "src", "children": [{ "label": "main.cpp" }, { "label": "io.cpp" }] },
        { "label": "README.md" }
      ]
    },
    {
      "kind": "Progress",
      "label": "进度",
      "value": 72,
      "total": 100,
      "unit": "%",
      "thresholds": [{ "at": 90, "tone": "error" }]
    },
    { "kind": "Badge", "text": "已启用", "tone": "success" },
    { "kind": "Markdown", "text": "# 标题\n\n- 列表项" }
  ]
}
