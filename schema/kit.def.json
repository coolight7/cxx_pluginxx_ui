{
  "schemaVersion": 1,
  "kitVersion": 1,
  "doc": "基础 kit：共享便捷组件（只装配、不含逻辑、不引用客户端专属块）",
  "components": [
    {
      "name": "title",
      "doc": "标题行",
      "params": [{ "name": "text", "type": "text", "required": true }],
      "variants": [{ "template": { "kind": "Text", "text": "$text", "type": "title" } }]
    },
    {
      "name": "hint",
      "doc": "次要说明行",
      "params": [{ "name": "text", "type": "text", "required": true }],
      "variants": [
        { "template": { "kind": "Text", "text": "$text", "type": "caption", "tone": "hint" } }
      ]
    },
    {
      "name": "text",
      "doc": "正文行",
      "params": [
        { "name": "text", "type": "text", "required": true },
        { "name": "tone", "type": "tone", "default": "normal" },
        { "name": "mono", "type": "bool", "default": false }
      ],
      "variants": [{ "template": { "kind": "Text", "text": "$text", "tone": "$tone", "mono": "$mono" } }]
    },
    {
      "name": "badge",
      "doc": "状态小标签",
      "params": [
        { "name": "text", "type": "text", "required": true },
        { "name": "tone", "type": "tone", "default": "accent" }
      ],
      "variants": [{ "template": { "kind": "Badge", "text": "$text", "tone": "$tone" } }]
    },
    {
      "name": "icon",
      "doc": "图标（目标不支持 Icon 时退化成 glyph 文本）",
      "params": [
        { "name": "name", "type": "string" },
        { "name": "glyph", "type": "string" },
        { "name": "size", "type": "size" },
        { "name": "tone", "type": "tone", "default": "normal" }
      ],
      "variants": [
        { "requires": ["Icon"], "template": { "kind": "Icon", "name": "$name", "glyph": "$glyph", "size": "$size", "tone": "$tone" } },
        { "template": { "kind": "Text", "text": "$glyph", "mono": true, "tone": "$tone" } }
      ]
    },
    {
      "name": "gap",
      "doc": "竖直留白（缺省用客户端默认行距）",
      "params": [{ "name": "size", "type": "size", "default": "gap" }],
      "variants": [{ "template": { "kind": "Gap", "size": "$size" } }]
    },
    {
      "name": "divider",
      "doc": "分隔线",
      "params": [],
      "variants": [{ "template": { "kind": "Divider" } }]
    },
    {
      "name": "button",
      "doc": "按钮",
      "params": [
        { "name": "label", "type": "text", "required": true },
        { "name": "variant", "type": "enum:buttonVariant", "default": "secondary" },
        { "name": "icon", "type": "string" },
        { "name": "disabled", "type": "bool", "default": false },
        { "name": "action", "type": "action" }
      ],
      "variants": [
        {
          "template": {
            "kind": "Button",
            "label": "$label",
            "variant": "$variant",
            "icon": "$icon",
            "disabled": "$disabled",
            "action": "$action"
          }
        }
      ]
    },
    {
      "name": "actionsRow",
      "doc": "一排等宽按钮（按钮列表里的每一项占一等份）",
      "params": [{ "name": "buttons", "type": "items", "required": true }],
      "variants": [
        {
          "template": {
            "kind": "Row",
            "gap": 12,
            "children": { "$map": "buttons", "wrap": { "kind": "Expanded", "children": ["$item"] } }
          }
        }
      ]
    },
    {
      "name": "card",
      "doc": "内容块（卡片）",
      "params": [
        { "name": "title", "type": "text" },
        { "name": "variant", "type": "enum:blockVariant", "default": "card" },
        { "name": "padding", "type": "edges" },
        { "name": "margin", "type": "edges" },
        { "name": "children", "type": "items" }
      ],
      "variants": [
        {
          "template": {
            "kind": "Block",
            "title": "$title",
            "variant": "$variant",
            "padding": "$padding",
            "margin": "$margin",
            "children": "$children"
          }
        }
      ]
    },
    {
      "name": "listRow",
      "doc": "卡片里的一行（标题 + 可选副标题 + 可选右侧文字）",
      "params": [
        { "name": "title", "type": "text", "required": true },
        { "name": "subtitle", "type": "text" },
        { "name": "trailing", "type": "text" },
        { "name": "action", "type": "action" }
      ],
      "variants": [
        {
          "template": {
            "kind": "Block",
            "variant": "inset",
            "padding": { "horizontal": 12, "vertical": 8 },
            "action": "$action",
            "children": [
              {
                "kind": "Row",
                "gap": 12,
                "cross": "center",
                "children": [
                  {
                    "kind": "Expanded",
                    "children": [
                      {
                        "kind": "Column",
                        "gap": 4,
                        "children": [
                          { "kind": "Text", "text": "$title" },
                          {
                            "$require": "subtitle",
                            "kind": "Text",
                            "text": "$subtitle",
                            "type": "caption",
                            "tone": "hint"
                          }
                        ]
                      }
                    ]
                  },
                  { "$require": "trailing", "kind": "Text", "text": "$trailing", "tone": "hint" }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "name": "section",
      "doc": "小节标题 + 若干行",
      "params": [
        { "name": "title", "type": "text", "required": true },
        { "name": "rows", "type": "items", "required": true }
      ],
      "variants": [
        {
          "template": {
            "kind": "Column",
            "gap": 8,
            "children": [
              { "kind": "Text", "text": "$title", "type": "title" },
              { "kind": "Column", "children": "$rows" }
            ]
          }
        }
      ]
    },
    {
      "name": "kv",
      "doc": "键值块（键列按最长键自适应）",
      "params": [
        { "name": "pairs", "type": "pairs", "required": true },
        { "name": "sep", "type": "string" }
      ],
      "variants": [
        {
          "template": { "kind": "KV", "pairs": "$pairs", "sep": "$sep", "keyWidth": "auto" }
        }
      ]
    },
    {
      "name": "table",
      "doc": "表格（未指定的列宽由客户端自动分配）",
      "params": [
        { "name": "columns", "type": "columns", "required": true },
        { "name": "rows", "type": "rows" },
        { "name": "header", "type": "bool", "default": true }
      ],
      "variants": [
        { "template": { "kind": "Table", "header": "$header", "columns": "$columns", "rows": "$rows" } }
      ]
    },
    {
      "name": "tree",
      "doc": "层级列表",
      "params": [
        { "name": "nodes", "type": "nodes", "required": true },
        { "name": "connector", "type": "bool", "default": true }
      ],
      "variants": [{ "template": { "kind": "Tree", "connector": "$connector", "nodes": "$nodes" } }]
    },
    {
      "name": "sparkline",
      "doc": "迷你趋势图",
      "params": [
        { "name": "data", "type": "numbers", "required": true },
        { "name": "height", "type": "int", "default": 1 },
        { "name": "glyphStyle", "type": "enum:sparkStyle", "default": "block" },
        { "name": "showLast", "type": "bool", "default": true },
        { "name": "tone", "type": "tone", "default": "accent" }
      ],
      "variants": [
        {
          "template": {
            "kind": "Sparkline",
            "data": "$data",
            "height": "$height",
            "glyphStyle": "$glyphStyle",
            "showLast": "$showLast",
            "tone": "$tone"
          }
        }
      ]
    },
    {
      "name": "progressRow",
      "doc": "一行进度（左侧标签 + 进度条）",
      "params": [
        { "name": "label", "type": "text" },
        { "name": "value", "type": "float", "required": true },
        { "name": "total", "type": "float", "default": 100 },
        { "name": "unit", "type": "string" }
      ],
      "variants": [
        {
          "template": {
            "kind": "Row",
            "gap": 12,
            "cross": "center",
            "children": [
              { "$require": "label", "kind": "Text", "text": "$label" },
              {
                "kind": "Expanded",
                "children": [
                  { "kind": "Progress", "value": "$value", "total": "$total", "unit": "$unit" }
                ]
              }
            ]
          }
        }
      ]
    }
  ],
  "runtime": [
    {
      "name": "cols",
      "doc": "n 列对应的 u 值（按客户端 cell 换算，缺省用 defaults.cell）",
      "params": [{ "name": "count", "type": "int", "required": true }]
    },
    {
      "name": "rows",
      "doc": "n 行对应的 u 值（按客户端 cell 换算，缺省用 defaults.cell）",
      "params": [{ "name": "count", "type": "int", "required": true }]
    }
  ]
}
